# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sign_language
DB_USER=root
DB_PASSWORD=your_password

# --- Security ---
SECRET_KEY=change_this_secret_use_a_long_random_string
REFRESH_SECRET_KEY=change_this_refresh_secret_use_a_different_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- App ---
ENVIRONMENT=development
