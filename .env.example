# ==========================================
# SignLearn - Global Environment Variables
# ==========================================

# Application Config
APP_NAME=SignLearn
APP_ENV=development
DEBUG=True
APP_URL=http://localhost:3000
API_V1_STR=/api/v1

# Security Secrets (Placeholder values for development)
SECRET_KEY=dev_secret_key_signlearn_infosys_2026_change_in_production
JWT_SECRET=dev_jwt_secret_key_signlearn_infosys_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Databases
POSTGRES_USER=signlearn
POSTGRES_PASSWORD=signlearn_secret
POSTGRES_DB=signlearn_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://signlearn:signlearn_secret@localhost:5432/signlearn_db

MONGO_USER=admin
MONGO_PASSWORD=admin_secret
MONGO_DB=signlearn_nosql
MONGO_HOST=localhost
MONGO_PORT=27017
MONGODB_URL=mongodb://admin:admin_secret@localhost:27017/signlearn_nosql?authSource=admin

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# External AI & Auth Provider Keys (Placeholders)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
OPENAI_API_KEY=your_openai_api_key_placeholder

# Next.js Frontend Public Variables
NEXT_PUBLIC_APP_NAME=SignLearn
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
