{
  "name": "signlearn-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Sign Language Learning & Assessment Platform - Infosys Internship Monorepo Architecture",
  "workspaces": [
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
