# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signspeak
DB_USER=postgres
DB_PASSWORD=YOUR_ACTUAL_POSTGRES_PASSWORD

# --- Security ---
SECRET_KEY=change_this_to_a_long_random_secret_key
REFRESH_SECRET_KEY=change_this_to_a_different_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Admin Account Provisioning ---
# Used by seed_admin.py and initial database setup to provision the platform administrator.
# Set these in your private .env file (NEVER commit real production passwords).
ADMIN_EMAIL=admin@signspeak.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Platform Administrator

# --- App ---
ENVIRONMENT=development